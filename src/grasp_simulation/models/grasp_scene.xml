<mujoco model="grasp_simulation">
    <compiler angle="radian" meshdir="../meshes" texturedir="../textures"/>
    
    <option gravity="0 0 -9.81" timestep="0.002" impratio="10">
        <flag contact="enable" energy="enable"/>
    </option>
    
    <visual>
        <headlight ambient="0.5 0.5 0.5"/>
    </visual>
    
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="groundplane" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="512" height="512"/>
        <material name="groundplane" texture="groundplane" texrepeat="10 10"/>
    </asset>
    
    <worldbody>
        <!-- Ground plane -->
        <geom name="floor" type="plane" size="2 2 0.1" material="groundplane"/>
        
        <!-- Table -->
        <body name="table" pos="0 0 0.5">
            <geom name="table_top" type="box" size="0.6 0.4 0.02" rgba="0.8 0.6 0.4 1"/>
        </body>
        
        <!-- Simple Allegro Hand Model -->
        <body name="hand_base" pos="0 0 0.8">
            <!-- Index finger -->
            <body name="if_link_0" pos="0.05 0 0">
                <joint name="if_joint_0" type="hinge" pos="0 0 0" axis="0 1 0" range="-0.5 0.5"/>
                <geom name="if_link_0_geom" type="box" size="0.02 0.015 0.04" rgba="0.8 0.8 0.8 1"/>
                
                <body name="if_link_1" pos="0 0 -0.04">
                    <joint name="if_joint_1" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                    <geom name="if_link_1_geom" type="box" size="0.015 0.015 0.03" rgba="0.7 0.7 0.7 1"/>
                    
                    <body name="if_link_2" pos="0 0 -0.03">
                        <joint name="if_joint_2" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                        <geom name="if_link_2_geom" type="box" size="0.015 0.015 0.025" rgba="0.6 0.6 0.6 1"/>
                        
                        <body name="if_link_3" pos="0 0 -0.025">
                            <joint name="if_joint_3" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                            <geom name="if_link_3_geom" type="box" size="0.015 0.015 0.02" rgba="0.5 0.5 0.5 1"/>
                        </body>
                    </body>
                </body>
            </body>
            
            <!-- Middle finger -->
            <body name="mf_link_0" pos="0.017 0 0">
                <joint name="mf_joint_0" type="hinge" pos="0 0 0" axis="0 1 0" range="-0.5 0.5"/>
                <geom name="mf_link_0_geom" type="box" size="0.02 0.015 0.04" rgba="0.8 0.8 0.8 1"/>
                
                <body name="mf_link_1" pos="0 0 -0.04">
                    <joint name="mf_joint_1" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                    <geom name="mf_link_1_geom" type="box" size="0.015 0.015 0.03" rgba="0.7 0.7 0.7 1"/>
                    
                    <body name="mf_link_2" pos="0 0 -0.03">
                        <joint name="mf_joint_2" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                        <geom name="mf_link_2_geom" type="box" size="0.015 0.015 0.025" rgba="0.6 0.6 0.6 1"/>
                        
                        <body name="mf_link_3" pos="0 0 -0.025">
                            <joint name="mf_joint_3" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                            <geom name="mf_link_3_geom" type="box" size="0.015 0.015 0.02" rgba="0.5 0.5 0.5 1"/>
                        </body>
                    </body>
                </body>
            </body>
            
            <!-- Ring finger -->
            <body name="rf_link_0" pos="-0.017 0 0">
                <joint name="rf_joint_0" type="hinge" pos="0 0 0" axis="0 1 0" range="-0.5 0.5"/>
                <geom name="rf_link_0_geom" type="box" size="0.02 0.015 0.04" rgba="0.8 0.8 0.8 1"/>
                
                <body name="rf_link_1" pos="0 0 -0.04">
                    <joint name="rf_joint_1" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                    <geom name="rf_link_1_geom" type="box" size="0.015 0.015 0.03" rgba="0.7 0.7 0.7 1"/>
                    
                    <body name="rf_link_2" pos="0 0 -0.03">
                        <joint name="rf_joint_2" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                        <geom name="rf_link_2_geom" type="box" size="0.015 0.015 0.025" rgba="0.6 0.6 0.6 1"/>
                        
                        <body name="rf_link_3" pos="0 0 -0.025">
                            <joint name="rf_joint_3" type="hinge" pos="0 0 0" axis="1 0 0" range="0 1.6"/>
                            <geom name="rf_link_3_geom" type="box" size="0.015 0.015 0.02" rgba="0.5 0.5 0.5 1"/>
                        </body>
                    </body>
                </body>
            </body>
            
            <!-- Thumb -->
            <body name="th_link_0" pos="-0.05 0 0">
                <joint name="th_joint_0" type="hinge" pos="0 0 0" axis="0 0 1" range="-1.0 1.0"/>
                <geom name="th_link_0_geom" type="box" size="0.02 0.015 0.04" rgba="0.8 0.8 0.8 1"/>
                
                <body name="th_link_1" pos="0 0 -0.04">
                    <joint name="th_joint_1" type="hinge" pos="0 0 0" axis="0 1 0" range="0 1.3"/>
                    <geom name="th_link_1_geom" type="box" size="0.015 0.015 0.03" rgba="0.7 0.7 0.7 1"/>
                    
                    <body name="th_link_2" pos="0 0 -0.03">
                        <joint name="th_joint_2" type="hinge" pos="0 0 0" axis="0 1 0" range="0 1.0"/>
                        <geom name="th_link_2_geom" type="box" size="0.015 0.015 0.025" rgba="0.6 0.6 0.6 1"/>
                        
                        <body name="th_link_3" pos="0 0 -0.025">
                            <joint name="th_joint_3" type="hinge" pos="0 0 0" axis="0 1 0" range="0 1.0"/>
                            <geom name="th_link_3_geom" type="box" size="0.015 0.015 0.02" rgba="0.5 0.5 0.5 1"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
        
        <!-- Object to grasp -->
        <body name="object" pos="0 0 0.55">
            <freejoint/>
            <geom name="cylinder" type="cylinder" size="0.03 0.06" 
                  rgba="0.8 0.2 0.2 1" mass="0.2" 
                  friction="1.0 0.005 0.0001" condim="4"/>
            <inertial pos="0 0 0" mass="0.2" 
                      diaginertia="0.00018 0.00018 0.00009"/>
        </body>
    </worldbody>
    
    <!-- Define actuators for Allegro hand -->
    <actuator>
        <!-- Index finger actuators -->
        <position name="if_actuator_0" joint="if_joint_0" kp="5" forcerange="-5 5"/>
        <position name="if_actuator_1" joint="if_joint_1" kp="5" forcerange="-5 5"/>
        <position name="if_actuator_2" joint="if_joint_2" kp="5" forcerange="-5 5"/>
        <position name="if_actuator_3" joint="if_joint_3" kp="5" forcerange="-5 5"/>
        
        <!-- Middle finger actuators -->
        <position name="mf_actuator_0" joint="mf_joint_0" kp="5" forcerange="-5 5"/>
        <position name="mf_actuator_1" joint="mf_joint_1" kp="5" forcerange="-5 5"/>
        <position name="mf_actuator_2" joint="mf_joint_2" kp="5" forcerange="-5 5"/>
        <position name="mf_actuator_3" joint="mf_joint_3" kp="5" forcerange="-5 5"/>
        
        <!-- Ring finger actuators -->
        <position name="rf_actuator_0" joint="rf_joint_0" kp="5" forcerange="-5 5"/>
        <position name="rf_actuator_1" joint="rf_joint_1" kp="5" forcerange="-5 5"/>
        <position name="rf_actuator_2" joint="rf_joint_2" kp="5" forcerange="-5 5"/>
        <position name="rf_actuator_3" joint="rf_joint_3" kp="5" forcerange="-5 5"/>
        
        <!-- Thumb actuators -->
        <position name="th_actuator_0" joint="th_joint_0" kp="5" forcerange="-5 5"/>
        <position name="th_actuator_1" joint="th_joint_1" kp="5" forcerange="-5 5"/>
        <position name="th_actuator_2" joint="th_joint_2" kp="5" forcerange="-5 5"/>
        <position name="th_actuator_3" joint="th_joint_3" kp="5" forcerange="-5 5"/>
    </actuator>
</mujoco>
