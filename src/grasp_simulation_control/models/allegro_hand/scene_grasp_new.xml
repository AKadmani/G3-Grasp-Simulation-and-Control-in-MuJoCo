        </body>
        
        <!-- Box object -->
        <body name="box_object" pos="0.2 0 0.15">
            <freejoint/>
            <geom name="box" type="box" size="0.04 0.04 0.04" rgba="0.8 0.2 0.2 1" mass="0.15"/>
        </body>
        
        <!-- Sphere object -->
        <body name="sphere_object" pos="-0.2 0 0.15">
            <freejoint/>
            <geom name="sphere" type="sphere" size="0.04" rgba="0.2 0.2 0.8 1" mass="0.1"/>
        </body>
    </worldbody>
</mujoco>
