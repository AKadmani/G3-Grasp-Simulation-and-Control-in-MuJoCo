<mujoco>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>
    
    <statistic extent="2" center="0 0 0.5"/>
    
    <worldbody>
        <!-- Include the complete hand scene -->
        <include file="scene_left.xml"/>
        
        <!-- Add objects in reachable positions -->
        <body name="cylinder_object" pos="0.1 0 0.1">
            <freejoint/>
            <geom name="cylinder" type="cylinder" size="0.03 0.08" rgba="0.2 0.7 0.3 1"/>
        </body>
        
        <body name="box_object" pos="0.15 0.1 0.1">
            <freejoint/>
            <geom name="box" type="box" size="0.04 0.04 0.04" rgba="0.8 0.2 0.2 1"/>
        </body>
        
        <body name="sphere_object" pos="0.05 -0.1 0.1">
            <freejoint/>
            <geom name="sphere" type="sphere" size="0.04" rgba="0.2 0.2 0.8 1"/>
        </body>
    </worldbody>
</mujoco>
