from setuptools import setup, find_packages
from glob import glob
import os

package_name = 'grasp_simulation_control'

setup(
    name=package_name,
    version='0.1.0',
    packages=[package_name],
    data_files=[
        ('share/ament_index/resource_index/packages',
            ['resource/' + package_name]),
        ('share/' + package_name, ['package.xml']),
        (os.path.join('share', package_name, 'launch'), glob('launch/*.launch.py')),
        # Add only the scene files, not all model files
        (os.path.join('share', package_name, 'models', 'allegro_hand'), 
         glob('models/allegro_hand/*.xml')),
    ],
    install_requires=['setuptools'],
    zip_safe=True,
    maintainer='your_name',
    maintainer_email='your_email@example.com',
    description='Grasp simulation and control using MuJoCo and ROS2',
    license='MIT',
    tests_require=['pytest'],
    entry_points={
        'console_scripts': [
            'grasp_simulation_node.py = grasp_simulation_control.grasp_simulation_node:main',
            'run_complete_simulation = grasp_simulation_control.run_complete_simulation:main',
        ],
    },
)